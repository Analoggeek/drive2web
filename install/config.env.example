# DriveToWeb installation answers
#
# This is the ONLY file you need to edit. Everything else is done by
#   sudo ./install.sh
#
# Format:  KEY=value      (no spaces around '=', no quotes needed for plain hosts)
# Lines starting with '#' are ignored. Re-run the installer any time: it keeps
# the secrets it already generated and only overwrites files it owns.

# ── the two things you must fill in ────────────────────────────────────────
# Your domain. Sites become  https://<name>.on.example.org
DOMAIN=example.org

# The public IP of THIS server (the one DNS points at).
SERVER_IP=203.0.113.10

# ── DNS provider, used to get the wildcard HTTPS certificate ───────────────
# acme.sh needs to add a TXT record automatically, because a wildcard
# certificate cannot be issued any other way.
#   cloudflare | routeset53(aws) | gcp | hetzner | dnsmadeeasy | manual | none
DNS_PROVIDER=cloudflare
# Cloudflare: create a token with Zone > DNS > Edit permission
#   https://dash.cloudflare.com/profile/api-tokens
DNS_API_TOKEN=CHANGEME

# aws / gcp / hetzner instead of cloudflare: set DNS_API_KEY + DNS_API_SECRET where
# the provider needs a pair (aws: access key id + secret; dnsmadeeasy: key + secret).
# manual = the installer prints the TXT record, waits for you to add it in your own
# DNS control panel, then continues. Slower, but works with any provider at all:
#   DNS_PROVIDER=manual   (and leave DNS_API_TOKEN as CHANGEME)
# none = something in front already does TLS, so the installer only makes a self-signed
# certificate for nginx itself. Right answer for a machine behind a Cloudflare tunnel
# (no public IP, nothing to point DNS at): see laptop-serve.sh + LAPTOP-SERVER.md.

# ── OneDrive sign-in (this is what makes "connect a drive" work) ────────────
# Azure portal -> App registrations -> New registration.
# Add BOTH of these under "Redirect URI" (Web platform):
#   https://api.example.org/.a/od/
#   https://api.example.org/.b/od/
# then copy the Application (client) ID here, plus a client secret.
ONEDRIVE_CLIENT_ID=CHANGEME
ONEDRIVE_CLIENT_SECRET=CHANGEME

# ── Google Drive: optional, and usually not possible for a new app ─────────
# Google blocks new OAuth apps that ask for Drive access until they pass
# verification (policy since Sep 2025), so leaving this empty is normal.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=

# ── e-mail: only needed for private sites (visitor "send me a code" e-mails) ─
# Leave SMTP_HOST empty to skip; the installer then turns off
# requireApprovedSites so sites are served without owner verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=              # default: no-reply@$DOMAIN  (must be able to send for that domain)

# ── extras (fine as they are) ──────────────────────────────────────────────
# Where the code and the data live on the box.
APP_DIR=/var/www/drvtw
DB_DIR=/var/lib/mongodb
BACKUP_DIR=/var/backups/drvtw

# Serve only sites whose owner proved they control that drive account.
# Needs working SMTP. Recommended TRUE for a public host; the installer sets it
# to FALSE automatically if SMTP_HOST is empty.
REQUIRE_APPROVED=auto

# Extra site names nobody may claim (the server's own hosts are blocked already)
RESERVED_NAMES=

# Install MongoDB on this box (no) / use an existing server (yes: then set URI)
INSTALL_MONGODB=yes
MONGO_URI=

# Which mongodb-org release to install (the apt repository line is built from this).
# 8.0 is the default. Older hardware matters here: MongoDB 5.0+ needs a CPU with AVX, and
# the current 7.0/8.0 builds are documented for Haswell and later, so a pre-2013 laptop can
# print "Illegal instruction (core dumped)" at the first start. Check the machine with
#   grep -c avx2 /proc/cpuinfo
# 0 means set MONGO_VER to a release your CPU supports, or run the database elsewhere
# (Atlas M0 is free) with INSTALL_MONGODB=no + MONGO_URI. See laptop-serve.sh check.
MONGO_VER=8.0

# ── what the installer writes, for your records ────────────────────────────
#  /etc/drvtw/config.env        this file, copied
#  /etc/drvtw/secrets.env       generated passwords + sessions secret (0600)
#  /etc/php*/fpm/pool.d/drvtw.conf
#  /etc/nginx/sites-available/drvtw*
#  /etc/logrotate.d/drvtw
#  /etc/cron.d/drvtw-backup
# Then:  cd $APP_DIR && /var/www/drvtw/html/index.php  is not how you check it —
# open https://www.$DOMAIN in a browser and the logs are at
#   sudo tail -f /var/log/drvtw/user.log
